#!/bin/bash
set -e
set -o pipefail

MODE="run"
AGENT="claude"
WORKSPACE=""
NEW=false
MAX_ITERATIONS=1
INCLUDE_LOCAL_CONFIG=false
CUSTOM_ENV=()
ENV_FILE=""
REVIEWER_MODEL=""
ORCHESTRATOR_MODEL=""
WORKER_MODEL=""

usage() {
    cat <<'EOF'
Usage: ralphish [OPTIONS] [WORKSPACE]

Options:
      --claude                     Run Claude (default)
      --codex                      Run Codex
      --agent AGENT                Select claude or codex
      --new                        Remove and recreate sandbox before running
      --rm                         Remove the sandbox for this workspace
      --max-iterations N           Maximum iterations to run (default: 1)
      --env KEY=VALUE              Pass environment variable to sandbox (repeatable)
      --env-file FILE              Load environment variables from a file
      --include-local-config       Sync local agent config into sandbox
      --reviewer-model MODEL       Model for the reviewer phase (default: sonnet-tier)
      --orchestrator-model MODEL   Model for the orchestrator phase (default: sonnet-tier)
      --worker-model MODEL         Fallback model for the worker phase when context.yaml has no tier
      --help                       Show this help
EOF
}

has_forwarded_env_key() {
    local key="$1"
    local env_var
    local line
    local entry_key

    for env_var in "${CUSTOM_ENV[@]}"; do
        if [ "${env_var%%=*}" = "$key" ]; then
            return 0
        fi
    done

    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [ -z "${line//[[:space:]]/}" ] && continue
            entry_key="${line%%=*}"
            if [ "$entry_key" = "$key" ]; then
                return 0
            fi
        done < "$ENV_FILE"
    fi

    return 1
}

while [[ $# -gt 0 ]]; do
    case $1 in
    --help)
        usage
        exit 0
        ;;
    --claude)
        AGENT="claude"
        shift
        ;;
    --codex)
        AGENT="codex"
        shift
        ;;
    --agent=*)
        AGENT="${1#--agent=}"
        shift
        ;;
    --agent)
        if [ -z "$2" ]; then
            echo "Error: --agent requires a value"
            exit 1
        fi
        AGENT="$2"
        shift 2
        ;;
    --new)
        NEW=true
        shift
        ;;
    --rm)
        MODE="rm"
        shift
        ;;
    --max-iterations)
        shift
        if [ -z "$1" ]; then
          echo "Usage: --max-iterations <iterations>"
          exit 1
        fi
        MAX_ITERATIONS="$1"
        shift
        ;;
    --env=*)
        CUSTOM_ENV+=("${1#--env=}")
        shift
        ;;
    --env)
        if [ -z "$2" ]; then
            echo "Error: --env requires a KEY=VALUE argument"
            exit 1
        fi
        CUSTOM_ENV+=("$2")
        shift 2
        ;;
    --env-file=*)
        ENV_FILE="${1#--env-file=}"
        shift
        ;;
    --env-file)
        if [ -z "$2" ]; then
            echo "Error: --env-file requires a file path argument"
            exit 1
        fi
        ENV_FILE="$2"
        shift 2
        ;;
    --include-local-config)
        INCLUDE_LOCAL_CONFIG=true
        shift
        ;;
    --reviewer-model=*)
        REVIEWER_MODEL="${1#--reviewer-model=}"
        shift
        ;;
    --reviewer-model)
        if [ -z "$2" ]; then
            echo "Error: --reviewer-model requires a model ID argument"
            exit 1
        fi
        REVIEWER_MODEL="$2"
        shift 2
        ;;
    --orchestrator-model=*)
        ORCHESTRATOR_MODEL="${1#--orchestrator-model=}"
        shift
        ;;
    --orchestrator-model)
        if [ -z "$2" ]; then
            echo "Error: --orchestrator-model requires a model ID argument"
            exit 1
        fi
        ORCHESTRATOR_MODEL="$2"
        shift 2
        ;;
    --worker-model=*)
        WORKER_MODEL="${1#--worker-model=}"
        shift
        ;;
    --worker-model)
        if [ -z "$2" ]; then
            echo "Error: --worker-model requires a model ID argument"
            exit 1
        fi
        WORKER_MODEL="$2"
        shift 2
        ;;
    *)
        WORKSPACE="$1"
        shift
        ;;
    esac
done

if [ -z "$WORKSPACE" ]; then
    WORKSPACE="."
fi

case "$AGENT" in
claude|codex) ;;
*)
    echo "Error: unsupported agent '$AGENT' (expected claude or codex)"
    usage
    exit 1
    ;;
esac

if [ -n "$ENV_FILE" ] && [ ! -f "$ENV_FILE" ]; then
    echo "Error: env file not found: $ENV_FILE"
    exit 1
fi

if [ "$MODE" != "rm" ]; then
    case "$AGENT" in
    claude)
        if [ -z "$CC_TOKEN" ]; then
            echo "Error: CC_TOKEN environment variable is not set"
            exit 1
        fi
        ;;
    codex)
        if [ -z "$OPENAI_API_KEY" ] && ! has_forwarded_env_key "OPENAI_API_KEY" && [ ! -f "$HOME/.codex/auth.json" ]; then
            echo "Error: Codex auth not found"
            echo "Run 'codex login' locally, set OPENAI_API_KEY in your shell, or pass it with --env/--env-file"
            exit 1
        fi
        ;;
    esac
fi

CONFIG_DIR="$(cd "$WORKSPACE" && pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Compute a sandbox name from a directory path and selected agent
compute_sandbox_name() {
    local dir="$1"
    local bn
    bn="$(basename "$dir")"
    local max=40
    if [ ${#bn} -gt $max ]; then
        local hash
        hash=$(echo -n "$bn" | shasum | cut -c1-6)
        bn="${bn:0:$((max - 7))}-$hash"
    fi
    echo "$AGENT-$bn"
}

# ─── Model tier table (update here when adopting a new model family) ────────
CLAUDE_MODEL_SIMPLE="claude-haiku-4-5-20251001"
CLAUDE_MODEL_MEDIUM="claude-sonnet-5"
CLAUDE_MODEL_COMPLEX="claude-opus-5"
CLAUDE_MODEL_FRONTIER="claude-fable-5"
CODEX_MODEL_SIMPLE="gpt-5.5"
CODEX_MODEL_MEDIUM="gpt-5.6-sol"
CODEX_MODEL_COMPLEX="gpt-5.6-sol"
CODEX_MODEL_FRONTIER="gpt-5.6-sol"

# Apply agent-appropriate sonnet-tier defaults for reviewer and orchestrator
if [ "$AGENT" = "claude" ]; then
    : "${REVIEWER_MODEL:=$CLAUDE_MODEL_MEDIUM}"
    : "${ORCHESTRATOR_MODEL:=$CLAUDE_MODEL_MEDIUM}"
else
    : "${REVIEWER_MODEL:=$CODEX_MODEL_MEDIUM}"
    : "${ORCHESTRATOR_MODEL:=$CODEX_MODEL_MEDIUM}"
fi

# Resolve worker model from context.yaml worker_tier (falls back to WORKER_MODEL)
resolve_worker_model() {
    local context_yaml="$1"
    local tier=""
    if [ -f "$context_yaml" ]; then
        tier=$(grep '^worker_tier:' "$context_yaml" 2>/dev/null | head -1 | sed 's/^worker_tier:[[:space:]]*//' | tr -d '"'"'" | xargs)
    fi
    case "$tier" in
    simple)
        [ "$AGENT" = "claude" ] && echo "$CLAUDE_MODEL_SIMPLE" || echo "$CODEX_MODEL_SIMPLE"
        return
        ;;
    medium)
        [ "$AGENT" = "claude" ] && echo "$CLAUDE_MODEL_MEDIUM" || echo "$CODEX_MODEL_MEDIUM"
        return
        ;;
    complex)
        [ "$AGENT" = "claude" ] && echo "$CLAUDE_MODEL_COMPLEX" || echo "$CODEX_MODEL_COMPLEX"
        return
        ;;
    frontier)
        [ "$AGENT" = "claude" ] && echo "$CLAUDE_MODEL_FRONTIER" || echo "$CODEX_MODEL_FRONTIER"
        return
        ;;
    "")
        # No tier in context.yaml — fall through to CLI flag
        ;;
    *)
        echo "Warning: unknown worker_tier '$tier' in context.yaml — ignoring" >&2
        ;;
    esac
    echo "$WORKER_MODEL"
}

case "$MODE" in
rm)
    # Remove sandbox for the config directory
    sandbox --agent "$AGENT" --rm "$CONFIG_DIR"
    # Also remove sandboxes for any repo-scoped tasks
    if [ -f "$CONFIG_DIR/progress.yaml" ]; then
        REPOS=$(python3 "$SCRIPT_DIR/select-task.py" "$CONFIG_DIR" --repos 2>/dev/null) || true
        while IFS= read -r repo; do
            [ -z "$repo" ] && continue
            repo_path="$(cd "$CONFIG_DIR" && cd "$repo" && pwd 2>/dev/null)" || continue
            [ "$repo_path" = "$CONFIG_DIR" ] && continue
            sandbox --agent "$AGENT" --rm "$repo_path" 2>/dev/null || true
        done <<< "$REPOS"
    fi
    ;;
*)
    # Build phase args (passed to every sandbox call)
    PHASE_ARGS=()
    for env_var in "${CUSTOM_ENV[@]}"; do PHASE_ARGS+=(--env "$env_var"); done
    [ -n "$ENV_FILE" ] && PHASE_ARGS+=(--env-file "$ENV_FILE")

    # Extra args for sandbox init (not repeated per phase)
    SANDBOX_INIT_EXTRA=(--exclude-plugin thedotmack/claude-mem)
    [ "$INCLUDE_LOCAL_CONFIG" = true ] && SANDBOX_INIT_EXTRA+=(--include-local-config)

    # ─── Phase prompts ──────────────────────────────────────────────────

    WORKER_PROMPT='You are the WORKER phase of a three-phase development loop (worker → reviewer → orchestrator).

Current iteration: {{ITERATION}}

## Setup (do this first, before any other shell command)

The harness has prepared an isolated git worktree at `.ralphish-wt` (detached HEAD at `origin/<default_branch>`, fresh upstream, git-crypt and other smudge filters already handled). All shell, git, and file-edit work for this iteration must happen inside that worktree — keep the user'\''s main checkout untouched.

Begin every shell session with `cd .ralphish-wt`. Inside the worktree, both `.ralphish/` and `progress.yaml` are symlinks back to the main repo'\''s copies — so paths like `.ralphish/context.yaml`, `.ralphish/summary.yaml`, and `progress.yaml` keep working without translation.

## Instructions

1. Check if `.ralphish/context.yaml` exists. If it does, read it for:
   - `assigned_task_id`: work on this specific task
   - `implementation_plan`: follow this plan as your starting guide for the task
   - `feedback` and `reviewer_remarks`: address this feedback from the previous attempt
   - `prior_attempt_branch` and `prior_attempt_head_sha`: your previous work to build on

2. If no context.yaml exists or it has no assigned_task_id, pick the first eligible task from `progress.yaml`:
   - Status is `todo`
   - All `blocked_by` IDs have status `done`

3. Before creating/switching to a feature branch, record the current HEAD SHA of the base branch — this is your `base_sha`.

4. Implement the task:
   - Extract the ticket identifier from the task title if it matches `NEX-XXXX:` format (e.g. `NEX-1449`)
   - You are running inside an isolated git worktree (`.ralphish-wt`) that the harness has reset to detached HEAD at `origin/<default_branch>`. Do all git work here. Do not try to leave or unregister this worktree.
   - Determine the default branch: `DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed "s|refs/remotes/origin/||")` (fall back to `main` if empty).
   - If `prior_attempt_branch` is set in context.yaml: `git fetch origin <default_branch> && git checkout <prior_attempt_branch> && git rebase origin/<default_branch>`. Resolve any conflicts. This keeps the PR up to date and avoids stale-base CI failures.
   - Otherwise: create the feature branch directly from the latest base — `git fetch origin <default_branch> && git checkout -B <branch-name> origin/<default_branch>`. Use `nex-<id>-<brief-slug>` as the branch name when a ticket ID exists (e.g. `nex-1449-module-rename`); otherwise use a descriptive name. `-B` guarantees you branch off the fresh remote tip and works whether or not the default branch is checked out elsewhere (the user'\''s main repo may have it checked out).
   - Before running `go get` for any `github.com/TV4/*` module, ensure private module access is configured: run `git config --global url."https://oauth2:${GH_TOKEN}@github.com/TV4".insteadOf "https://github.com/TV4"` and `go env -w GOPRIVATE=github.com/TV4/* GONOSUMDB=github.com/TV4/*`. If `GH_TOKEN` is empty, skip the `go get` and leave a TODO comment.
   - **Before writing any middleware, transport helpers, logging, metrics, tracing, rate limiting, or circuit-breaking code**: check go-kit (`github.com/go-kit/kit`, `github.com/go-kit/log`) for existing implementations first. If go-kit already provides the functionality, use it rather than writing a custom solution.
   - Implement the changes
   - Run the linter (`golangci-lint run ./...` if present, otherwise `go vet ./...`) and fix all warnings/errors before committing
   - Run all tests/checks and fix any problems
   - Commit your work (one logical change per commit)

5. After committing, record the feature branch HEAD SHA — this is your `head_sha`.

6. **Self-review before finishing**: Run `git diff <base_sha>..<head_sha>` yourself and verify:
   - Every requirement from the task description is addressed
   - No unintended changes, debug prints, or leftover TODO comments
   - Tests pass (run the project test suite if one exists)
   If you spot issues, fix them and amend/add commits before proceeding.

7. **Push and create PR** after self-review passes:
   - Push the feature branch: `git push -u origin <branch>`
   - Create a draft PR if one does not already exist. If the task has a `NEX-XXXX` ticket ID, include it in the title prefix and body:
     `gh pr view <branch> --json url -q .url 2>/dev/null || gh pr create --draft --title "NEX-XXXX: <task title>" --body "Closes NEX-XXXX\n\n<brief description of what was done>" --head <branch>`
     Otherwise use: `--title "<task title>" --body "<brief description of what was done>"`
   - Record the PR URL returned above (use an empty string if push or PR creation fails — do not abort)

8. **Poll CI and fix failures** (up to 3 retries) after the PR is created:
   - If `pr_url` is empty, set `ci_status: no_checks` and skip this step
   - Parse `owner/repo` from `pr_url` (e.g. `https://github.com/TV4/partners/pull/3` → `TV4/partners`)
   - For each attempt (maximum 3 fix attempts, plus the initial poll = 4 polls total):
     a. **Poll** until all runs for the current `head_sha` are complete (up to ~5 min):
        `gh run list --repo <owner/repo> --branch <branch> --json name,conclusion,status,headSha --limit 30 2>/dev/null`
        Filter to entries where `headSha == <current head_sha>`. If any have `status` other than `completed`, wait 20 seconds and retry. After ~5 minutes without completion set `ci_status: timed_out` and stop retrying.
     b. **Evaluate** the completed runs:
        - Empty list → `ci_status: no_checks`; stop retrying
        - Ignore runs whose `name` starts with `.github/workflows/` (empty-matrix / missing-environment runs — non-blocking)
        - Any remaining run with `conclusion: failure` or `conclusion: cancelled` → `ci_status: failing`
        - All remaining runs with `conclusion: success` or `conclusion: skipped` → `ci_status: passing`; stop retrying
     c. **If `ci_status: failing`** and attempts remain:
        - Fetch the failure logs: `gh run list --repo <owner/repo> --branch <branch> --json databaseId,conclusion,headSha --limit 30 2>/dev/null`, filter to failing runs for this `head_sha`, then for each: `gh run view <run-id> --repo <owner/repo> --log-failed 2>/dev/null`
        - Analyse the logs, fix the root cause in code, commit the fix, push: `git push origin <branch>`
        - Update `head_sha` to the new HEAD: `git rev-parse HEAD`
        - Continue to the next attempt
     d. If all 3 fix attempts are exhausted and CI is still failing, keep `ci_status: failing` and proceed (the reviewer and orchestrator will handle it)

9. **Assign Linear ticket** if the task has a `NEX-XXXX` ticket ID:
   - Use `git config user.email` to get your email address
   - Use the Linear MCP `list_issues` tool to find the issue by identifier (e.g. `NEX-1449`), get its UUID `id`
   - Use the Linear MCP `list_users` tool to find your user UUID by matching email
   - Call the Linear MCP `save_issue` with `id` and `assigneeId` to assign the issue to yourself
   - If the Linear MCP is unavailable or any step fails, skip silently — do not abort

10. Write `.ralphish/summary.yaml` with this exact structure:
    ```yaml
    task_id: <integer>
    task_title: "<string>"
    base_sha: "<40-char sha>"
    head_sha: "<40-char sha>"
    branch: "<branch-name>"
    pr_url: "<GitHub PR URL, or empty string if push/PR creation failed>"
    ci_status: "<passing|failing|timed_out|no_checks>"
    what_was_done: "<description of implementation>"
    findings:
      - "<finding 1>"
    suggestions:
      - "<suggestion 1>"
    ```

You MUST:
- Only work on a single task per iteration
- Always use a feature branch for development
- Commit one logical change at a time to the feature branch
- Self-review your diff before writing summary.yaml
- Push the feature branch and create a draft PR before writing summary.yaml
- Poll CI and attempt fixes (up to 3 retries) before writing summary.yaml
- Write .ralphish/summary.yaml before finishing
- NOT update progress.yaml — the orchestrator handles that
- NOT report token usage — the harness reads it from the agent stream'

    REVIEWER_PROMPT='You are the REVIEWER phase of a three-phase development loop (worker → reviewer → orchestrator).

## Setup (do this first, before any other shell command)

The worker did its work inside an isolated git worktree at `.ralphish-wt`. Your git inspection (diff, checkout, test run) must happen there too — do not touch the user'\''s main checkout. Begin every shell session with `cd .ralphish-wt`. Inside the worktree, both `.ralphish/` and `progress.yaml` are symlinks back to the main repo'\''s copies, so paths like `.ralphish/summary.yaml`, `.ralphish/review.yaml`, and `progress.yaml` work transparently.

## Instructions

1. Read `.ralphish/summary.yaml` to get the `task_id`, `base_sha`, `head_sha`, and `branch`.

2. Read `progress.yaml` to understand the task requirements (find the task matching `task_id`).

3. Examine the exact diff using: `git diff <base_sha>..<head_sha>`
   Use the SHAs from summary.yaml — do NOT diff branch names, as branches may include unrelated commits.

4. Run the project test suite (if one exists) on the feature branch at `head_sha`:
   - Checkout `head_sha`, run tests, record pass/fail counts
   - If tests fail, this is strong evidence for `request_changes`

5. Review the implementation for:
   - **Correctness**: Does it match the task requirements?
   - **Quality**: Code style, error handling, edge cases
   - **Test coverage**: Are there adequate tests? Do they pass?
   - **Task alignment**: Does the work stay within scope?
   - **TVM conventions** — flag any violation of the following as `request_changes`:
     - *Naming*: service/module/package names must be lowercase-with-hyphens (or lowercase no-separator for Go packages), no redundant suffixes (`-service`, `-api`, `-backend`), prefer agent nouns (`transcoder` not `transcoding-service`)
     - *API response shape*: list endpoints must wrap in `{ "items": [...] }`; single-item endpoints must return 404 for missing resources; JSON fields must be camelCase; enum values must be SCREAMING_SNAKE_CASE
     - *Standard libraries*: Go services must use go-kit (`github.com/go-kit/kit`, `github.com/go-kit/log`) for middleware, transport, logging, metrics, tracing — not custom implementations; Node.js services must use `@tv4/node-kit-*` equivalents
     - *Data storage*: PostgreSQL (Aurora) for relational data — no t-series instances in production; DynamoDB should use on-demand mode unless provisioned is explicitly justified; Valkey for caching
     - *Observability*: any new metrics must include `brand`, `job`, and `account` labels; OpenTelemetry semantic conventions must be followed for HTTP metrics and traces
     - *Language choice*: new services must use Go+Huma for high-traffic/low-latency workloads, TypeScript+Hono for moderate traffic; flag if a new service uses a framework other than Huma or Hono
     - *Infrastructure (CDKTF)*: AWS infrastructure for TV4 services must use `@tv4/cdktf-extras` prefabs (`InfraStack`, `EcsFargateApp`, `EcsAlb`, `setupGithubActions`) instead of hand-rolling raw CDKTF/Terraform providers — flag any stack that imports directly from `@cdktf/provider-aws` or `@cdktf/provider-github` for resources that cdktf-extras already abstracts (ECS, ALB, ECR, IAM, Route53, GitHub Actions environment)

6. **Verify base freshness**: Confirm the PR branch is up to date with the default branch.
   - Determine the default branch: `DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed "s|refs/remotes/origin/||")` (fall back to `main` if empty).
   - Fetch the latest base: `git fetch origin <default_branch> 2>/dev/null || true`
   - Check if `head_sha` already contains every commit on `origin/<default_branch>`: `git merge-base --is-ancestor origin/<default_branch> <head_sha>`
   - If exit code is non-zero, the PR branch is behind the default branch and needs rebasing. Flag this in remarks (include the count of missing commits from `git rev-list --count <head_sha>..origin/<default_branch>`) and set verdict to `request_changes`. Never `approve` a stale branch — CI may pass against a stale base and still break after merge.

7. **Check CI status** using the Actions API (requires Actions: Read permission):
   - If `pr_url` is empty or missing in summary.yaml, set `ci_status: no_checks` and skip this step
   - Parse `owner/repo` from `pr_url` (e.g. `https://github.com/TV4/partners/pull/3` → `TV4/partners`)
   - Get the branch name and `head_sha` from summary.yaml
   - Poll until all runs for the commit are complete (up to ~5 min). Each iteration:
     `gh run list --repo <owner/repo> --branch <branch> --json name,conclusion,status,headSha --limit 30 2>/dev/null`
     Filter to entries where `headSha == head_sha` from summary.yaml. If any have `status` other than `completed`, wait 20 seconds and retry. If still not all complete after ~5 minutes, set `ci_status: timed_out`.
   - Once all runs are completed (or if the list is empty after filtering):
     - Empty list → `ci_status: no_checks`
     - Ignore any run whose `name` starts with `.github/workflows/` — these are workflow runs where no jobs executed (empty matrix, missing environment, etc.) and are non-blocking infrastructure issues. Note them in `ci_details` but do not count them as failures.
     - Any remaining run has `conclusion: failure` or `conclusion: cancelled` → `ci_status: failing`; list their `name` values in `ci_details`
     - All remaining runs have `conclusion: success` or `conclusion: skipped` → `ci_status: passing`
   - **IMPORTANT**: If the command returns any API error (non-zero exit, error message in output), set `ci_status: failing` and record the error in `ci_details`. Never use `no_checks` when you cannot read CI results — only use it when the filtered list is confirmed empty.
   - CI failure is strong evidence for `request_changes`

8. Write `.ralphish/review.yaml` with this exact structure:
   ```yaml
   task_id: <integer>
   base_sha: "<40-char sha>"
   head_sha: "<40-char sha>"
   verdict: approve  # or: request_changes
   test_results: "<pass/fail summary, or '\''no test suite found'\''>"
   ci_status: "<passing|failing|timed_out|no_checks>"
   ci_details: "<names of failing CI checks, or empty>"
   remarks:
     - "<specific remark — reference files and line numbers>"
   ```

You MUST:
- NOT modify any code, configuration, or project files
- NOT update progress.yaml
- Use the exact base_sha..head_sha range from summary.yaml for your diff
- Be specific in remarks — reference files and line numbers
- Poll CI checks and include ci_status in review.yaml
- Only use `approve` or `request_changes` as the verdict
- Never set verdict to `approve` if ci_status is `failing`
- Never set verdict to `approve` if the PR branch is behind the default branch — request a rebase
- NOT report token usage — the harness reads it from the agent stream'

